---
// Plantilla de módulo (DESIGN.md §7): cinco escenas como paradas del camino grueso.
//   1. Gancho      → frontmatter (titulo, bajada, pregunta)
//   2. Escena jugable, 3. Revelación, 4. Evidencia → <Parada> en el cuerpo MDX
//   5. Qué hacer   → frontmatter (recomendaciones) + remate con llamado a la acción
import type { CollectionEntry } from 'astro:content';
import { getCollection, getEntry } from 'astro:content';
import Base from './Base.astro';
import BarraProgreso from '../components/scroll/BarraProgreso.astro';
import InterruptorEvidencia from '../components/evidencia/InterruptorEvidencia.astro';
import TarjetaFuente from '../components/evidencia/TarjetaFuente.astro';
import BotonEstatico from '../components/scroll/BotonEstatico.astro';
import Compartir from '../components/editorial/Compartir.astro';
import Camino from '../components/camino/Camino.astro';
import Parada from '../components/camino/Parada.astro';
import Remate from '../components/camino/Remate.astro';

interface Props { modulo: CollectionEntry<'modulos'> }
const { modulo } = Astro.props;
const d = modulo.data;
const pilar = await getEntry(d.pilar);
const otros = (await getCollection('modulos')).filter((m) => m.id !== modulo.id).slice(0, 2);
const tipos: Record<string, string> = { dato: 'Dato', paper: 'Paper', caso: 'Caso', comunicado: 'Comunicado oficial', prensa: 'Prensa' };

// *palabra* en el titular → resaltado rosa (DESIGN §2). Se escapa el resto del texto.
const escapar = (t: string) => t.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);
const titular = escapar(d.titulo).replace(/\*(.+?)\*/g, '<span class="resaltado-titular">$1</span>');
const tituloPlano = d.titulo.replace(/\*/g, '');
---
<Base titulo={tituloPlano} descripcion={d.bajada}>
  <BarraProgreso />

  <article class="modulo" data-modulo-camino data-color={d.color}>
    <Camino />

    <!-- 1. GANCHO -->
    <Parada escena="gancho" etiqueta={pilar?.data.nombre ?? 'Módulo'} titulo={titular} nivel="h1">
      {d.ejemplo && <p class="aviso-ejemplo">Módulo de ejemplo: texto de relleno y datos inventados para probar la plantilla.</p>}
      <p class="modulo__bajada">{d.bajada}</p>
      <p class="modulo__pregunta">{d.pregunta}</p>
      <div class="modulo__controles">
        <InterruptorEvidencia />
        <BotonEstatico />
      </div>
    </Parada>

    <!-- 2 a 4. ESCENA JUGABLE, REVELACIÓN Y EVIDENCIA (MDX) -->
    <slot />

    <!-- 5. QUÉ HACER -->
    <Parada escena="que-hacer" etiqueta="Qué hacer" titulo="Qué hacer con esto">
      {d.recomendaciones.length > 0 && (
        <ul class="modulo__recomendaciones">
          {d.recomendaciones.map((r) => <li>{r}</li>)}
        </ul>
      )}
    </Parada>

    <Remate>
      <p class="etiqueta etiqueta--banda">Sigue el camino</p>
      <div class="modulo__acciones">
        {d.brief && <a class="boton" href={`/investigacion/${d.brief}`}>Leer el brief completo</a>}
        {otros.map((m) => <a class="boton boton--claro" href={`/modulos/${m.id}`}>Probar: {m.data.titulo.replace(/\*/g, '')}</a>)}
        {otros.length === 0 && <a class="boton boton--claro" href="/pilares">Explorar los pilares</a>}
        <Compartir titulo={tituloPlano} />
      </div>
    </Remate>
  </article>

  {d.fuentes.length > 0 && (
    <section id="fuentes" class="fuentes lectura" aria-labelledby="fuentes-titulo">
      <h2 id="fuentes-titulo">Fuentes</h2>
      <ol>
        {d.fuentes.map((f) => (
          <li id={`fuente-${f.id}`}>
            <span class="etiqueta">{tipos[f.tipo]}{f.latam && ' · Colombia / LatAm'}</span><br />
            {f.url ? <a href={f.url} target="_blank" rel="noopener">{f.titulo}</a> : f.titulo}
            {(f.autor || f.anio) && <span class="fuentes__meta">. {[f.autor, f.anio].filter(Boolean).join(', ')}</span>}
          </li>
        ))}
      </ol>
    </section>
  )}

  <TarjetaFuente fuentes={d.fuentes} />
</Base>

<style>
  .modulo { position: relative; overflow-x: clip; padding-bottom: 0; }

  .modulo__bajada { font-size: var(--t-lead); color: var(--muted); }
  .modulo__pregunta {
    font-size: var(--t-lead);
    background: var(--rosa);
    color: var(--on-color);
    padding: var(--s-3) var(--s-4);
    border-radius: var(--r-card);
  }
  .modulo__controles { display: flex; flex-wrap: wrap; gap: var(--s-2); margin-top: var(--s-4); }
  .modulo__recomendaciones { padding-left: 1.2em; margin: 0; }
  .modulo__recomendaciones li { margin-bottom: var(--s-2); }
  .modulo__acciones { display: flex; flex-wrap: wrap; justify-content: center; gap: var(--s-2); margin-top: var(--s-4); }

  :global(.resaltado-titular) {
    background: var(--rosa);
    color: var(--on-color);
    padding: 0 0.12em;
    border-radius: 0.18em;
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
  }

  .fuentes { margin-top: var(--s-6); font-size: var(--t-small); }
  .fuentes ol { padding-left: 1.4em; }
  .fuentes li { margin-bottom: var(--s-3); scroll-margin-top: 6rem; }
  .fuentes li:target { background: var(--mantequilla); color: var(--on-color); outline: 6px solid var(--mantequilla); border-radius: 2px; }
  .fuentes li:target .etiqueta { color: var(--on-color); }
  .fuentes__meta { color: var(--muted); }
</style>
