---
import '../styles/base.css';

interface Props {
  titulo?: string;
  descripcion?: string;
}
const {
  titulo,
  descripcion = 'Umbral: investigación en Behavioral HCI y Human-Centered AI para Latinoamérica, hecha de artículos interactivos.',
} = Astro.props;

const tituloCompleto = titulo ? `${titulo} · Umbral` : 'Umbral';
const ruta = Astro.url.pathname.replace(/\/$/, '') || '/';
const nav = [
  { href: '/pilares', texto: 'Pilares' },
  { href: '/investigacion', texto: 'Investigación' },
  { href: '/sobre-mi', texto: 'Sobre mí' },
  { href: '/colabora', texto: 'Colabora' },
];
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descripcion} />
    <meta name="theme-color" content="#FCFCF0" />
    <meta name="color-scheme" content="light only" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/bricolage-grotesque-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/questrial-latin.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>
      // Antes de pintar: JS disponible, versión estática y modo evidencia.
      (function () {
        var d = document.documentElement;
        d.setAttribute('data-js', '');
        try {
          var q = new URLSearchParams(location.search);
          if (q.has('estatico') && q.get('estatico') !== '0') d.setAttribute('data-estatico', '');
          if (q.has('estatico')) localStorage.setItem('umbral-estatico', q.get('estatico') === '0' ? '0' : '1');
          if (localStorage.getItem('umbral-estatico') === '1') d.setAttribute('data-estatico', '');
          if (localStorage.getItem('umbral-evidencia') === '1') d.setAttribute('data-evidencia', '');
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <a class="saltar" href="#contenido">Saltar al contenido</a>
    <header class="cabecera">
      <div class="contenedor cabecera__fila">
        <a class="logo" href="/" aria-label="Umbral, inicio">umbral</a>
        <nav aria-label="Principal">
          <ul>
            {nav.map((n) => (
              <li><a href={n.href} aria-current={ruta.startsWith(n.href) ? 'page' : undefined}>{n.texto}</a></li>
            ))}
          </ul>
        </nav>
      </div>
    </header>

    <main id="contenido">
      <slot />
    </main>

    <footer class="pie">
      <div class="contenedor pie__fila">
        <p><span class="logo">umbral</span><br />Behavioral HCI y Human-Centered AI para Latinoamérica.</p>
        <p class="pie__nota">Este sitio no recoge datos de lectores. Las simulaciones corren solo en tu navegador.</p>
      </div>
    </footer>
  </body>
</html>

<style>
  .cabecera {
    position: relative; z-index: 50;
    background: var(--bg);
    border-bottom: 1.5px solid var(--outline);
  }
  .cabecera__fila {
    display: flex; align-items: center; gap: var(--s-2) var(--s-4);
    min-height: 4rem; flex-wrap: wrap;
    padding-block: var(--s-2);
  }
  .logo {
    font-family: var(--font-title); font-weight: 800;
    font-size: 1.6rem; letter-spacing: -0.04em; text-decoration: none;
    margin-right: auto; display: inline-flex; align-items: center; min-height: 44px;
  }
  nav { order: 3; width: 100%; }
  nav ul { display: flex; flex-wrap: wrap; gap: 0 var(--s-4); list-style: none; margin: 0; padding: 0; font-size: var(--t-small); }
  nav a { display: inline-flex; align-items: center; min-height: 44px; text-decoration: none; }
  nav a[aria-current='page'] { text-decoration: underline; text-decoration-thickness: 2px; }
  @media (hover: hover) { nav a:hover { text-decoration: underline; } }

  @media (min-width: 52rem) {
    .cabecera { position: sticky; top: 0; }
    nav { order: 0; width: auto; }
  }

  .pie { margin-top: var(--s-7); border-top: 1.5px solid var(--outline); }
  .pie__fila {
    display: flex; flex-wrap: wrap; justify-content: space-between; gap: var(--s-4);
    padding-block: var(--s-5) calc(var(--s-5) + env(safe-area-inset-bottom));
    font-size: var(--t-small); color: var(--muted);
  }
  .pie .logo { color: var(--fg); }
  .pie__nota { max-width: 26rem; }
</style>
