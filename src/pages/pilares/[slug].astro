---
// Página de pilar. Etapa 1: ruta y encabezado. La página completa llega en la etapa 3.
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const pilares = await getCollection('pilares');
  return pilares.map((pilar) => ({ params: { slug: pilar.id }, props: { pilar } }));
}
const { pilar } = Astro.props;
const p = pilar.data;
---
<Base titulo={p.nombre} descripcion={p.pregunta} pilar={pilar.id}>
  <section class="lectura" style="padding-top: var(--s-6)">
    <p class="etiqueta">Pilar {p.numero}</p>
    <h1>{p.nombre}</h1>
    <p style="font-size: var(--t-lead)">{p.pregunta}</p>
    <p class="etiqueta">Próximamente</p>
  </section>
</Base>
