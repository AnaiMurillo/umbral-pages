---
import { getCollection, render } from 'astro:content';
import Modulo from '../../layouts/Modulo.astro';
import { componentesMdx } from '../../components/mdx';

export async function getStaticPaths() {
  const modulos = await getCollection('modulos');
  return modulos.map((modulo) => ({ params: { slug: modulo.id }, props: { modulo } }));
}

const { modulo } = Astro.props;
const { Content } = await render(modulo);
---
<Modulo modulo={modulo}>
  <Content components={componentesMdx} />
</Modulo>
