---
// Página de brief (GUIA §1.1, TEXTOS_FINALES §6): lectura larga, sin camino.
import { getCollection, getEntry, render } from 'astro:content';
import Lectura from '../../layouts/Lectura.astro';

export async function getStaticPaths() {
  const briefs = await getCollection('investigacion');
  return briefs.map((brief) => ({ params: { slug: brief.id }, props: { brief } }));
}
const { brief } = Astro.props;
const { Content, headings } = await render(brief);
const pilar = await getEntry(brief.data.pilar);
---
<Lectura brief={brief} pilar={pilar!} indice={headings.filter((h) => h.depth === 2)}>
  <Content />
</Lectura>
