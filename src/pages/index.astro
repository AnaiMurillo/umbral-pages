---
import Base from '../layouts/Base.astro';
import Cerebro from '../components/inicio/Cerebro.astro';
import CaminoPilares from '../components/inicio/CaminoPilares.astro';

// Manifiesto: texto de relleno hasta que Isabel lo redacte.
const frases = [
  '[Relleno] Cada interfaz es un umbral: lo cruzamos sin darnos cuenta.',
  '[Relleno] Aquí no se cuenta cómo nos comportamos frente a la tecnología: se prueba.',
];
---
<Base>
  <section class="hero contenedor" aria-labelledby="hero-titulo">
    <div class="hero__texto">
      <p class="etiqueta etiqueta--banda">Behavioral HCI · Human-Centered AI · LatAm</p>
      <h1 id="hero-titulo" class="hero__titulo">Lo que <span class="resaltado-rosa">hacemos</span> frente a una pantalla, explicado con el scroll.</h1>
      {frases.map((f) => <p class="hero__frase">{f}</p>)}
      <a class="boton" href="#mapa-titulo">Recorrer los pilares</a>
    </div>
    <div class="hero__cerebro">
      <Cerebro />
    </div>
  </section>

  <CaminoPilares />
</Base>

<style>
  .hero {
    display: grid; gap: var(--s-4); align-items: center;
    padding-block: var(--s-5) var(--s-4);
  }
  .hero__titulo { font-size: clamp(2.875rem, 1.5rem + 4vw, 5.5rem); margin-top: var(--s-3); }
  .hero__frase { font-size: var(--t-lead); color: var(--muted); max-width: 34rem; }
  .hero__cerebro { order: -1; width: min(100%, 26rem); justify-self: center; }
  .resaltado-rosa {
    background: var(--rosa); color: var(--on-color);
    padding: 0 0.1em; border-radius: 0.16em;
    -webkit-box-decoration-break: clone; box-decoration-break: clone;
  }
  @media (min-width: 52rem) {
    .hero { grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); min-height: calc(100svh - 4rem); padding-block: var(--s-5); }
    .hero__cerebro { order: 0; width: 100%; }
  }

</style>
