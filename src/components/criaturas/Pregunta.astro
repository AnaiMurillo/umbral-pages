---
// Criatura del Gancho: un domo que se asoma con una pregunta. 6 formas.
// data-desde = "x y rotación escala": desde dónde llega cada pieza al armarse.
---
<g data-pieza data-desde="0 110 0 0.85"><path d="M40 320 A160 160 0 0 1 360 320 Z" fill="var(--cr1)" /></g>
<g data-pieza data-desde="-40 40 -35 0.6"><g transform="rotate(-25 95 215)"><rect x="75" y="160" width="40" height="100" rx="20" fill="var(--cr2)" /></g></g>
<g data-pieza data-desde="0 30 0 0.3">
  <circle cx="160" cy="225" r="21" fill="var(--blanco)" /><circle cx="240" cy="225" r="21" fill="var(--blanco)" />
  <circle cx="166" cy="230" r="9" fill="var(--tinta)" /><circle cx="246" cy="230" r="9" fill="var(--tinta)" />
</g>
<g data-pieza data-desde="0 20 0 0.4"><path d="M182 274 q18 14 36 0" stroke="var(--tinta)" stroke-width="6" fill="none" stroke-linecap="round" /></g>
<g data-pieza data-desde="40 -60 30 0.5"><path d="M262 72 a40 40 0 1 1 50 40 q-12 5 -12 24" stroke="var(--cr3)" stroke-width="24" fill="none" stroke-linecap="round" /></g>
<g data-pieza data-desde="20 -90 0 0.2"><circle cx="300" cy="170" r="13" fill="var(--cr3)" /></g>
