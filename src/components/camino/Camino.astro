---
// El camino grueso (DESIGN.md §5b): una cinta SVG de color plano detrás de todo el módulo.
// El trazado se calcula en el navegador a partir de dónde quedan las paradas (camino.ts),
// con una composición para computador y otra para móvil.
// Decorativo: aria-hidden. Sin JavaScript no se dibuja y el contenido se lee completo.
---
<div class="camino" aria-hidden="true" data-camino>
  <svg class="camino__svg" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none">
    <g data-tramos></g>
  </svg>
</div>

<style>
  .camino {
    position: absolute; inset: 0;
    z-index: 0; pointer-events: none;
    overflow: hidden;
  }
  .camino__svg { position: absolute; left: 0; top: 0; width: 100%; height: 100%; overflow: visible; }
  .camino :global(.camino__cinta) {
    fill: none;
    stroke: var(--path);
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .camino :global(.camino__medida) { fill: none; stroke: none; visibility: hidden; }
</style>

<script>
  import { iniciarCaminos } from './camino';
  iniciarCaminos();
</script>
