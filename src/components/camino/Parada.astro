---
// Una parada del camino: criatura grande + tarjeta blanca + objetos secundarios.
// En los artículos se usa a través de <Escena n={…}> (components/articulo/Escena.astro).
import Criatura from '../criaturas/Criatura.astro';
import Objetos from './Objetos.astro';
import { paradas, alternativa, type Escena, type Pilar, type NombreCriatura } from './composiciones';

interface Props {
  /** Escena del módulo o pilar (camino del Inicio). */
  escena: Escena | Pilar;
  /** id de la sección (para enlazar, p. ej. /#confianza). */
  id?: string;
  /** Etiqueta de escena (p. ej. "Para empezar"). Opcional. */
  etiqueta?: string;
  /** Nombre accesible cuando no hay título visible. */
  nombre?: string;
  titulo?: string;
  /** El Gancho usa h1; el resto h2. */
  nivel?: 'h1' | 'h2';
  criatura?: NombreCriatura;
  /** Pilar de esta parada: colorea su tramo de camino y sus criaturas (mapa de pilares). */
  pilar?: string;
  /** Criatura del pilar del artículo: si una escena la repite, se usa otra. */
  evitar?: NombreCriatura;
  /** Mostrar el slot "figura" en lugar de la criatura (p. ej. el cerebro). */
  conFigura?: boolean;
}
const { escena, etiqueta, nombre, titulo, nivel = 'h2', criatura, id: idSeccion, pilar, evitar, conFigura = false } = Astro.props;
const comp = paradas[escena];
let nombreCriatura = criatura ?? comp.criatura;
if (!criatura && evitar && nombreCriatura === evitar) nombreCriatura = alternativa[nombreCriatura];
const id = `parada-${escena}`;
const Titulo = nivel;
---
<section id={idSeccion} class:list={['parada', `parada--${escena}`, `parada--${comp.lado}`]} data-parada={escena} data-pilar={pilar} data-pilar-parada={pilar} aria-labelledby={titulo ? `${id}-titulo` : undefined} aria-label={titulo ? undefined : (nombre ?? etiqueta)}>
  <div class="parada__criatura" data-ancla>
    {conFigura && Astro.slots.has('figura') ? <slot name="figura" /> : <Criatura nombre={nombreCriatura} />}
    <Objetos lista={comp.objetos} id={escena} />
  </div>
  <div class="parada__tarjeta tarjeta">
    <slot name="antes" />
    {etiqueta && <p class="etiqueta etiqueta--banda parada__etiqueta">{etiqueta}</p>}
    {titulo && <Titulo id={`${id}-titulo`} class="parada__titulo"><Fragment set:html={titulo} /></Titulo>}
    <slot />
  </div>
</section>

<style>
  .parada {
    position: relative;
    z-index: 1;
    display: grid;
    width: 100%;
    max-width: calc(var(--container) + 2 * var(--gutter));
    margin-inline: auto;
    padding-inline: var(--gutter);
  }
  .parada__etiqueta { margin-bottom: var(--s-3); }
  .parada__titulo { font-size: var(--t-card); }
  .parada__tarjeta { position: relative; z-index: 3; min-width: 0; }
  .parada__tarjeta :global(> p:not(.etiqueta)) { max-width: var(--measure); }
  .parada__criatura { position: relative; z-index: 2; }

  /* La parada inactiva baja a 55 % (nunca a 0). Solo con animación activa. */
  /* El fondo blanco de la tarjeta se mantiene opaco: solo se atenúa su contenido. */
  :global([data-modulo-camino][data-animado]) .parada__tarjeta > :global(*),
  :global([data-modulo-camino][data-animado]) .parada__criatura {
    transition: opacity 400ms var(--ease);
  }
  :global([data-modulo-camino][data-animado]) .parada:not([data-activa]) .parada__tarjeta > :global(*),
  :global([data-modulo-camino][data-animado]) .parada:not([data-activa]) .parada__criatura { opacity: 0.55; }

  /* ===================== MÓVIL (composición propia) =====================
     Una columna; la criatura (60-90 % del ancho) va arriba, alineada a su lado,
     y la tarjeta debajo. Máximo una criatura y tres objetos por escena. */
  .parada { grid-template-columns: minmax(0, 1fr); padding-block: 9svh 4svh; gap: var(--s-3); }
  .parada__criatura { width: 76vw; max-width: 30rem; }
  .parada--izq .parada__criatura { justify-self: start; margin-left: -2vw; }
  .parada--der .parada__criatura { justify-self: end; margin-right: -2vw; }
  .parada--cabecera .parada__criatura { width: 70vw; }
  .parada--cabecera { padding-top: 4svh; }

  /* ===================== COMPUTADOR (composición propia) =====================
     Dos columnas en 1080 px: criatura y tarjeta alternan lados alrededor del camino.
     La criatura baja hacia la sección vecina (solapamiento). */
  @media (min-width: 52rem) {
    .parada {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: center;
      column-gap: clamp(2rem, 5vw, 5rem);
      padding-block: 16vh 10vh;
    }
    .parada__criatura { width: clamp(280px, 40vw, 500px); margin: 0; top: 9vh; }
    .parada--izq .parada__criatura { grid-column: 1; grid-row: 1; justify-self: center; margin-left: 0; }
    .parada--izq .parada__tarjeta { grid-column: 2; grid-row: 1; }
    .parada--der .parada__criatura { grid-column: 2; grid-row: 1; justify-self: center; margin-right: 0; }
    .parada--der .parada__tarjeta { grid-column: 1; grid-row: 1; }

    .parada--cabecera { grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); padding-top: 8vh; }
    .parada--cabecera .parada__criatura { width: clamp(300px, 36vw, 520px); top: 14vh; }
    .parada--cabecera .parada__titulo { font-size: clamp(2.875rem, 1.6rem + 3.4vw, 5rem); }
  }
</style>
