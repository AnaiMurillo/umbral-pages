---
// Botón de modo claro / oscuro. Por defecto sigue al sistema; la elección se recuerda.
---
<button type="button" class="tema" data-boton-tema aria-label="Cambiar a modo oscuro">
  <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false">
    <circle cx="12" cy="12" r="9" fill="currentColor" />
    <path d="M12 3a9 9 0 0 1 0 18z" fill="var(--bg)" />
  </svg>
</button>

<style>
  .tema {
    width: 44px; height: 44px; border-radius: 50%;
    border: 1.5px solid var(--outline); background: var(--surface);
    display: grid; place-items: center; cursor: pointer; color: var(--fg);
  }
  @media (hover: hover) { .tema:hover { background: var(--band); } }
</style>

<script>
  const raiz = document.documentElement;
  const oscuroAhora = () =>
    raiz.dataset.theme ? raiz.dataset.theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;

  document.querySelectorAll<HTMLButtonElement>('[data-boton-tema]').forEach((b) => {
    const pintar = () => b.setAttribute('aria-label', oscuroAhora() ? 'Cambiar a modo claro' : 'Cambiar a modo oscuro');
    pintar();
    b.addEventListener('click', () => {
      const oscuro = !oscuroAhora();
      raiz.dataset.theme = oscuro ? 'dark' : 'light';
      try { localStorage.setItem('umbral-tema', oscuro ? 'oscuro' : 'claro'); } catch {}
      pintar();
      window.dispatchEvent(new CustomEvent('umbral:tema'));
    });
  });
</script>
