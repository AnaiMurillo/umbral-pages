---
// Afirmación con respaldo: <Afirmacion fuente="id">texto</Afirmacion>
// Siempre se abre con clic o teclado; el modo evidencia además la resalta.
interface Props { fuente: string }
const { fuente } = Astro.props;
---
<button type="button" class="afirmacion" data-afirmacion={fuente} aria-haspopup="dialog"><slot /><span class="afirmacion__marca" aria-hidden="true"></span><span class="visualmente-oculto"> (ver fuente)</span></button>

<style>
  .afirmacion {
    all: unset;
    display: inline;
    cursor: pointer;
    text-decoration: underline dotted 2px;
    text-decoration-color: var(--muted);
    text-underline-offset: 0.25em;
    border-radius: 0.2em;
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
  }
  @media (hover: hover) { .afirmacion:hover { background: var(--band); } }
  .afirmacion:focus-visible { outline: 3px solid var(--fg); outline-offset: 2px; }
  .afirmacion__marca {
    font-size: 0.7em; vertical-align: super; line-height: 0; margin-left: 0.1em; color: var(--muted);
  }
  .afirmacion__marca::before { content: attr(data-n); }

  /* Modo evidencia: resaltado mantequilla con texto tinta (también en oscuro) */
  :global(html[data-evidencia]) .afirmacion {
    background: var(--highlight);
    color: var(--on-color);
    text-decoration: none;
    box-shadow: none;
    padding: 0 0.1em;
  }
  :global(html[data-evidencia]) .afirmacion__marca { color: var(--on-color); font-weight: 700; }
</style>
