---
// Acordeón para comunicados oficiales y documentos largos.
// Usa <details> nativo: funciona sin JavaScript, con teclado y con lectores de pantalla.
interface Props { titulo: string; meta?: string; abierto?: boolean }
const { titulo, meta, abierto = false } = Astro.props;
---
<details class="acordeon" open={abierto}>
  <summary>
    <span class="acordeon__titulo">{titulo}</span>
    {meta && <span class="acordeon__meta">{meta}</span>}
  </summary>
  <div class="acordeon__cuerpo"><slot /></div>
</details>

<style>
  /* Acordeón de fuente (DESIGN §7): <details> nativo, funciona sin JavaScript. */
  .acordeon {
    margin: var(--s-3) 0;
    border: 1.5px solid var(--outline); border-radius: calc(var(--r-card) * 0.7);
    background: var(--surface);
  }
  summary {
    cursor: pointer; list-style: none;
    display: grid; grid-template-columns: 1fr auto; gap: var(--s-1) var(--s-3);
    padding: var(--s-3) var(--s-4); min-height: 44px; align-items: center;
    border-radius: inherit;
  }
  summary::-webkit-details-marker { display: none; }
  summary::after {
    content: '+'; grid-row: 1 / span 2; grid-column: 2;
    width: 32px; height: 32px; border-radius: 50%; display: grid; place-items: center;
    background: var(--band); color: var(--fg); font-size: 1.3rem; line-height: 1;
  }
  .acordeon[open] summary::after { content: '−'; }
  .acordeon__titulo { font-weight: 700; }
  .acordeon__meta { font-size: var(--t-small); color: var(--muted); }
  .acordeon__cuerpo { padding: 0 var(--s-4) var(--s-4); }
  .acordeon__cuerpo :global(p:last-child) { margin-bottom: 0; }
</style>
