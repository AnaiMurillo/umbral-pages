---
// Acordeón para comunicados oficiales y documentos largos.
// Usa <details> nativo: funciona sin JavaScript, con teclado y con lectores de pantalla.
interface Props { titulo: string; meta?: string; abierto?: boolean }
const { titulo, meta, abierto = false } = Astro.props;
---
<details class="acordeon" open={abierto}>
  <summary>
    <span class="acordeon__titulo">{titulo}</span>
    {meta && <span class="acordeon__meta">{meta}</span>}
  </summary>
  <div class="acordeon__cuerpo"><slot /></div>
</details>

<style>
  .acordeon {
    margin: var(--e-3) 0;
    border: var(--borde); border-radius: var(--radio);
    background: var(--color-superficie);
  }
  summary {
    cursor: pointer; list-style: none;
    display: grid; grid-template-columns: 1fr auto; gap: var(--e-1) var(--e-3);
    padding: var(--e-3) var(--e-4); min-height: 44px; align-items: center;
  }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: '+'; font-size: 1.5rem; line-height: 1; grid-row: 1 / span 2; grid-column: 2; }
  .acordeon[open] summary::after { content: '−'; }
  .acordeon[open] summary { border-bottom: 1px solid color-mix(in srgb, var(--color-linea) 40%, transparent); }
  .acordeon__titulo { font-weight: 700; }
  .acordeon__meta { font-size: var(--t-s); color: var(--color-texto-suave); }
  .acordeon__cuerpo { padding: var(--e-3) var(--e-4); }
  .acordeon__cuerpo :global(p:last-child) { margin-bottom: 0; }
</style>
