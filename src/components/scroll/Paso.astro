---
// Un paso de texto dentro de <EscenaFija>. Avanza el gráfico al entrar en pantalla.
---
<div class="paso" data-paso>
  <div class="paso__caja"><slot /></div>
</div>

<style>
  .paso {
    min-height: 85svh;
    display: flex; align-items: center;
    padding-block: var(--e-5);
  }
  .paso:first-child { margin-top: 20svh; }
  .paso:last-child { min-height: 70svh; }
  @media (max-width: 51.99rem) {
    /* La caja se activa al cruzar el 60 % de la pantalla: aparece en la parte baja */
    .paso { align-items: flex-start; min-height: 100svh; padding-block: 0; }
    .paso:first-child { margin-top: 0; }
    .paso:last-child { padding-bottom: 60svh; }
  }
  .paso__caja {
    background: var(--color-superficie);
    border: var(--borde);
    border-radius: var(--radio);
    padding: var(--e-4);
    box-shadow: 4px 4px 0 var(--color-texto);
    opacity: 0.55;
    transition: opacity var(--dur-media) var(--curva);
  }
  .paso[data-activo] .paso__caja { opacity: 1; }
  .paso__caja :global(p:last-child) { margin-bottom: 0; }

  /* Versión estática: lectura continua, sin pausas largas */
  :global(html[data-estatico]) .paso,
  :global(html:not([data-js])) .paso { min-height: 0 !important; margin-top: 0; padding-block: var(--e-2) !important; }
  :global(html[data-estatico]) .paso__caja,
  :global(html:not([data-js])) .paso__caja { opacity: 1; }
  @media (prefers-reduced-motion: reduce) {
    .paso { min-height: 0 !important; margin-top: 0 !important; padding-block: var(--e-2) !important; }
    .paso__caja { opacity: 1; }
  }
</style>
