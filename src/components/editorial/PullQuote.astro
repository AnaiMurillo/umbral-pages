---
// Cita destacada. "quien" y "contexto" son opcionales; "fuente" enlaza a una fuente del módulo.
interface Props { quien?: string; contexto?: string; fuente?: string }
const { quien, contexto, fuente } = Astro.props;
---
<figure class="cita" data-reveal>
  <blockquote><slot /></blockquote>
  {(quien || contexto) && (
    <figcaption>
      {quien && <strong>{quien}</strong>}{quien && contexto && ', '}{contexto}
      {fuente && <> · <a href={`#fuente-${fuente}`}>fuente</a></>}
    </figcaption>
  )}
</figure>

<style>
  /* Pull quote con resaltado mantequilla (DESIGN §7). */
  .cita { margin: var(--s-5) 0; padding: 0; }
  blockquote {
    margin: 0; font-family: var(--font-title); font-weight: 700;
    font-size: clamp(1.5rem, 1.2rem + 1.2vw, 2.2rem); line-height: 1.12; letter-spacing: -0.02em;
  }
  blockquote :global(p) { margin: 0; display: inline; background: var(--highlight); color: var(--on-color);
    padding: 0 0.15em; border-radius: 0.15em; -webkit-box-decoration-break: clone; box-decoration-break: clone; }
  figcaption { margin-top: var(--s-3); font-size: var(--t-small); color: var(--muted); }
</style>
