---
// Bloque de lectura rápida: lo esencial en 3 a 5 puntos para quien llega sin contexto.
interface Props { titulo?: string }
const { titulo = 'En 30 segundos' } = Astro.props;
---
<aside class="rapida" aria-label={titulo}>
  <p class="etiqueta">{titulo}</p>
  <slot />
</aside>

<style>
  .rapida { margin: var(--s-4) 0; padding: var(--s-4); background: var(--band); border-radius: calc(var(--r-card) * 0.7); }
  .rapida :global(ul) { margin: var(--s-2) 0 0; padding-left: 1.2em; }
  .rapida :global(li) { margin-bottom: var(--s-2); }
  .rapida :global(li:last-child) { margin-bottom: 0; }
</style>
