---
// Escena 3 — Revelación: el hallazgo en una sola frase.
// El hallazgo se toma del frontmatter (hallazgo:); el slot es el respaldo breve.
interface Props { hallazgo: string }
const { hallazgo } = Astro.props;
---
<section class="revelacion" aria-labelledby="revelacion-titulo">
  <p class="etiqueta" id="revelacion-titulo">El hallazgo</p>
  <p class="revelacion__frase" data-reveal>{hallazgo}</p>
  <div class="revelacion__respaldo"><slot /></div>
</section>

<style>
  .revelacion {
    margin: var(--e-7) 0; padding: var(--e-5) 0;
    border-top: 4px solid var(--color-texto); border-bottom: 4px solid var(--color-texto);
  }
  .revelacion__frase {
    font-family: var(--fuente-titular); font-size: var(--t-xl); line-height: 1.12;
    margin: var(--e-3) 0 var(--e-4);
  }
  .revelacion__respaldo :global(p:last-child) { margin-bottom: 0; }
</style>
