---
// Botón de compartir: usa el menú nativo del teléfono; en escritorio copia el enlace.
interface Props { titulo: string }
const { titulo } = Astro.props;
---
<button type="button" class="boton boton--claro" data-compartir={titulo}>Compartir</button>
<span class="visualmente-oculto" aria-live="polite" data-compartir-aviso></span>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-compartir]').forEach((b) => {
    b.addEventListener('click', async () => {
      const url = location.origin + location.pathname;
      const aviso = b.nextElementSibling as HTMLElement | null;
      try {
        if (navigator.share) {
          await navigator.share({ title: b.dataset.compartir, url });
        } else {
          await navigator.clipboard.writeText(url);
          b.textContent = 'Enlace copiado';
          if (aviso) aviso.textContent = 'Enlace copiado al portapapeles';
          setTimeout(() => (b.textContent = 'Compartir'), 2500);
        }
      } catch {}
    });
  });
</script>
