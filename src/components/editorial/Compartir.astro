---
// Compartir (TEXTOS_FINALES §5.1): botón "Copiar enlace" con confirmación. Nada se envía.
---
<div class="compartir" data-compartir>
  <button type="button" class="boton">Copiar enlace</button>
  <span class="compartir__estado" role="status" aria-live="polite"></span>
</div>

<style>
  .compartir { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s-2) var(--s-3); }
  .compartir__estado { font-size: var(--t-small); color: var(--muted); }
</style>

<script>
  import { textos } from '../../data/sitio';
  document.querySelectorAll<HTMLElement>('[data-compartir]').forEach((caja) => {
    const b = caja.querySelector('button');
    const estado = caja.querySelector<HTMLElement>('.compartir__estado');
    b?.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(location.origin + location.pathname);
        if (estado) estado.textContent = 'Enlace copiado.';
      } catch { if (estado) estado.textContent = textos.errorCopiar; }
    });
  });
</script>
