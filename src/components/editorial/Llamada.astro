---
// Llamada de atención. tipo: "dato" (celeste) o "ojo" (rosa).
interface Props { titulo?: string; tipo?: 'dato' | 'ojo' }
const { titulo, tipo = 'dato' } = Astro.props;
---
<aside class={`llamada llamada--${tipo}`} data-reveal>
  {titulo && <p class="llamada__titulo">{titulo}</p>}
  <slot />
</aside>

<style>
  /* Llamada: banda suave. tipo "dato" = celeste, "ojo" = rosa. Texto siempre tinta. */
  .llamada { margin: var(--s-4) 0; padding: var(--s-4); border-radius: calc(var(--r-card) * 0.7); color: var(--on-color); }
  .llamada--dato { background: var(--celeste); }
  .llamada--ojo  { background: var(--rosa); }
  .llamada :global(a), .llamada :global(.afirmacion__marca) { color: var(--on-color); }
  .llamada__titulo { font-family: var(--font-title); font-weight: 700; font-size: var(--t-lead); margin-bottom: var(--s-2); }
  .llamada :global(p:last-child) { margin-bottom: 0; }
</style>
