---
// Camino de los pilares: la misma interfaz de los módulos (camino grueso que se dibuja
// con el scroll), con una parada por pilar. Cada parada muestra la criatura del
// mecanismo, su descripción y sus módulos. Termina en un remate con llamado a colaborar.
import { getCollection } from 'astro:content';
import Camino from '../camino/Camino.astro';
import Parada from '../camino/Parada.astro';
import Remate from '../camino/Remate.astro';
import type { Pilar } from '../camino/composiciones';

interface Props {
  titulo?: string;
  /** h1 en /pilares; h2 en el Inicio (el h1 es el del hero). */
  nivel?: 'h1' | 'h2';
}
const { titulo = 'Cinco pilares, cinco mecanismos', nivel = 'h2' } = Astro.props;
const Titulo = nivel;
const NivelParada = nivel === 'h1' ? 'h2' : 'h3';

const pilares = (await getCollection('pilares')).sort((a, b) => a.data.orden - b.data.orden);
// Solo artículos publicados y que no sean de ejemplo (TEXTOS_FINALES §5.3).
const articulos = (await getCollection('articulos')).filter((a) => !a.data.ejemplo && a.data.estado === 'publicado');
const limpio = (t: string) => t.replace(/\*/g, '');
---
<div class="pilares" data-modulo-camino data-inicio-x="0.94">
  <Camino />

  <header class="pilares__intro contenedor">
    <Titulo id="mapa-titulo" class="pilares__titulo">{titulo}</Titulo>
    <p class="pilares__bajada">Cada pilar agrupa un mecanismo de comportamiento, no una industria. Baja y recorre el camino.</p>
  </header>

  {pilares.map((p) => {
    const suyos = articulos.filter((m) => m.data.pilar.id === p.id);
    return (
      <Parada escena={p.id as Pilar} id={p.id} pilar={p.id} criatura={p.data.criatura} etiqueta={p.data.numero} titulo={p.data.nombre} nivel={NivelParada}>
        <p class="pilar__subtitulo">{p.data.subtitulo}</p>
        <p class="pilar__frase">{p.data.frase}</p>
        {suyos.length > 0 ? (
          <ul class="pilar__articulos" aria-label={`Artículos de ${p.data.nombre}`}>
            {suyos.map((m) => (
              <li><a class="pilar__articulo" href={`/articulos/${m.id}`}>{limpio(m.data.titulo)}</a></li>
            ))}
          </ul>
        ) : (
          <p class="pilar__pronto"><span class="etiqueta">Próximamente.</span> El primer artículo de este pilar está en preparación.</p>
        )}
        <a class="boton boton--claro pilar__ver" href={`/pilares/${p.id}`}>Ver el pilar →<span class="visualmente-oculto"> {p.data.nombre}</span></a>
      </Parada>
    );
  })}

  <Remate>
    <h2 class="pilares__cierre">¿Investigamos juntos?</h2>
    <p>Si trabajas en una fundación, una empresa, un medio o una universidad y tienes una pregunta sobre cómo las personas viven la tecnología, escríbeme.</p>
    <div class="pilares__acciones">
      <a class="boton" href="/colabora">Colabora</a>
      <a class="boton boton--claro" href="/investigacion">Ver la investigación</a>
    </div>
  </Remate>
</div>

<style>
  .pilares { position: relative; overflow-x: clip; }
  .pilares__intro { position: relative; z-index: 1; padding-top: var(--s-6); }
  /* Banda del color del fondo: el texto nunca queda sobre la cinta (en oscuro la cinta es crema). */
  .pilares__intro > * { background: var(--bg); width: fit-content; max-width: 100%; padding-inline: var(--s-2); margin-inline: calc(-1 * var(--s-2)); border-radius: 12px; }
  .pilares__titulo { font-size: var(--t-card); }
  .pilares__bajada { color: var(--muted); max-width: 32rem; font-size: var(--t-lead); }
  .pilares :global(.parada) { scroll-margin-top: 5rem; }

  .pilar__subtitulo { font-size: var(--t-lead); }
  .pilar__frase {
    display: inline;
    background: var(--pilar); color: var(--on-color);
    padding: 0.1em 0.3em; border-radius: 0.25em;
    -webkit-box-decoration-break: clone; box-decoration-break: clone;
  }
  .pilar__articulos { list-style: none; margin: var(--s-4) 0 0; padding: 0; display: grid; gap: var(--s-2); }
  .pilar__articulo { display: flex; align-items: center; min-height: 44px; font-family: var(--font-title); font-weight: 700; }
  .pilar__pronto { margin: var(--s-4) 0 var(--s-3); padding-top: var(--s-3); border-top: 1.5px solid var(--outline); color: var(--muted); }
  .pilar__pronto .etiqueta { color: var(--fg); }
  .pilar__ver { margin-top: var(--s-3); }
  .pilares__cierre { font-size: var(--t-card); margin-top: var(--s-3); }
  .pilares__acciones { display: flex; flex-wrap: wrap; justify-content: center; gap: var(--s-2); }
</style>
