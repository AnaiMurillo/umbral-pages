---
// Cerebro de partículas del Inicio. Lleva descripción (DESIGN §8): es la única
// figura no decorativa. Sin JavaScript no se dibuja; el texto se lee igual.
---
<figure class="cerebro">
  <canvas
    class="cerebro__lienzo"
    data-cerebro
    role="img"
    aria-label="Un cerebro de perfil dibujado con cientos de puntos de colores unidos por líneas finas; una onda de actividad lo recorre. Representa el enfoque analítico de Umbral."
  ></canvas>
</figure>

<style>
  .cerebro { margin: 0; width: 100%; }
  .cerebro__lienzo { display: block; width: 100%; aspect-ratio: 4 / 3; }
</style>

<script>
  import { iniciarCerebro } from './cerebro';
  document.querySelectorAll<HTMLCanvasElement>('[data-cerebro]').forEach(iniciarCerebro);
</script>
