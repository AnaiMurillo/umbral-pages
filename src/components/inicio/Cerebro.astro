---
// Cerebro de partículas del Inicio. Lleva descripción (DESIGN §8): es la única
// figura no decorativa. Sin JavaScript no se dibuja; el texto se lee igual.
---
<figure class="cerebro">
  <canvas
    class="cerebro__lienzo"
    data-cerebro
    role="img"
    aria-label="Un cerebro hecho de cientos de puntos de colores que se agrupan y se unen con líneas finas. Representa el enfoque analítico de Umbral."
  ></canvas>
  <button type="button" class="cerebro__pausa" data-cerebro-pausa aria-pressed="false" hidden>
    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><rect x="6" y="5" width="4" height="14" rx="1.5" fill="currentColor" /><rect x="14" y="5" width="4" height="14" rx="1.5" fill="currentColor" /></svg>
    <span data-cerebro-pausa-texto>Pausar animación</span>
  </button>
</figure>

<style>
  .cerebro { margin: 0; width: 100%; display: grid; justify-items: center; gap: var(--s-2); }
  .cerebro__pausa {
    display: inline-flex; align-items: center; gap: var(--s-2);
    min-height: 44px; padding: 0 var(--s-3);
    border: 1.5px solid var(--outline); border-radius: var(--r-pill);
    background: var(--surface); color: var(--fg); font-size: var(--t-small); cursor: pointer;
  }
  .cerebro__pausa[hidden] { display: none; }
  .cerebro__lienzo { display: block; width: 100%; aspect-ratio: 5 / 4; }
</style>

<script>
  import { iniciarCerebro } from './cerebro';
  document.querySelectorAll<HTMLCanvasElement>('[data-cerebro]').forEach(iniciarCerebro);
</script>
