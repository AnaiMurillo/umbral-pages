---
// Mapa de pilares: navegación visual en lugar de menú.
// Cada pilar es una zona con su mecanismo, teaser y módulos.
import { getCollection } from 'astro:content';
import Glifo from './Glifo.astro';

interface Props { titulo?: string; nivel?: 'h1' | 'h2' }
const { titulo = 'Cinco pilares, cinco mecanismos', nivel = 'h2' } = Astro.props;
const Titulo = nivel;

const pilares = (await getCollection('pilares')).sort((a, b) => a.data.orden - b.data.orden);
const modulos = await getCollection('modulos');
---
<section class="mapa contenedor" aria-labelledby="mapa-titulo">
  <Titulo id="mapa-titulo" class="mapa__titulo">{titulo}</Titulo>
  <p class="mapa__bajada">Cada pilar agrupa un mecanismo de comportamiento, no una industria.</p>

  <ul class="mapa__zonas">
    {pilares.map((p, i) => {
      const suyos = modulos.filter((m) => m.data.pilar.id === p.id);
      return (
        <li class={`zona zona--${i + 1}`} data-reveal>
          <a class="zona__enlace" href={`/pilares#${p.id}`} id={p.id}>
            <span class="zona__numero" aria-hidden="true">0{p.data.orden}</span>
            <Glifo pilar={p.id} />
            <h3 class="zona__nombre">{p.data.nombre}</h3>
            <p class="zona__mecanismo">{p.data.mecanismo}</p>
            <p class="zona__teaser">{p.data.teaser}</p>
          </a>
          {suyos.length > 0 ? (
            <ul class="zona__modulos" aria-label={`Módulos de ${p.data.nombre}`}>
              {suyos.map((m) => (
                <li><a href={`/modulos/${m.id}`}>{m.data.titulo}</a>{m.data.ejemplo && <span class="etiqueta"> · ejemplo</span>}</li>
              ))}
            </ul>
          ) : (
            <p class="zona__vacio">Próximamente</p>
          )}
        </li>
      );
    })}
  </ul>
</section>

<style>
  .mapa { padding-block: var(--e-6); }
  .mapa__bajada { color: var(--color-texto-suave); max-width: 32rem; }

  .mapa__zonas {
    list-style: none; margin: var(--e-5) 0 0; padding: 0;
    display: grid; gap: var(--e-4);
    grid-template-columns: 1fr;
  }
  /* Escritorio: un mapa asimétrico, no una grilla de tarjetas iguales */
  @media (min-width: 52rem) {
    .mapa__zonas {
      grid-template-columns: repeat(6, 1fr);
      grid-auto-rows: minmax(10rem, auto);
    }
    .zona--1 { grid-column: 1 / span 3; grid-row: span 2; }
    .zona--2 { grid-column: 4 / span 3; }
    .zona--3 { grid-column: 4 / span 3; }
    .zona--4 { grid-column: 1 / span 2; }
    .zona--5 { grid-column: 3 / span 4; }
  }

  .zona {
    position: relative;
    background: var(--color-superficie);
    border: var(--borde);
    border-radius: var(--radio);
    padding: var(--e-4);
    display: flex; flex-direction: column; gap: var(--e-2);
    transition: transform var(--dur-media) var(--curva), box-shadow var(--dur-media) var(--curva);
  }
  .zona:nth-child(odd)  { --acento: var(--color-dato); }
  .zona:nth-child(even) { --acento: var(--color-destacado); }
  .zona:hover, .zona:focus-within {
    transform: translateY(-4px);
    box-shadow: 6px 6px 0 var(--color-texto);
    background: var(--acento);
  }

  .zona__enlace { text-decoration: none; display: flex; flex-direction: column; gap: var(--e-2); }
  .zona__enlace:focus-visible { outline-offset: 6px; }
  .zona__numero { font-family: var(--fuente-titular); font-size: var(--t-s); color: var(--color-texto-suave); }
  .zona__nombre { font-size: var(--t-xl); margin: 0; }
  .zona__mecanismo { margin: 0; font-size: var(--t-m); }
  .zona__teaser { margin: 0; color: var(--color-texto-suave); font-size: var(--t-s); }

  .zona__modulos { list-style: none; margin: auto 0 0; padding: var(--e-3) 0 0; border-top: 1px solid currentColor; font-size: var(--t-s); }
  .zona__vacio { margin: auto 0 0; padding-top: var(--e-3); font-size: var(--t-s); color: var(--color-texto-suave); }
</style>
