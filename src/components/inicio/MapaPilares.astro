---
// Mapa de pilares: navegación visual en lugar de menú.
// Cada pilar es una zona con su mecanismo, teaser y módulos.
import { getCollection } from 'astro:content';
import Glifo from './Glifo.astro';

interface Props { titulo?: string; nivel?: 'h1' | 'h2' }
const { titulo = 'Cinco pilares, cinco mecanismos', nivel = 'h2' } = Astro.props;
const Titulo = nivel;
const Sub = nivel === 'h1' ? 'h2' : 'h3';

const pilares = (await getCollection('pilares')).sort((a, b) => a.data.orden - b.data.orden);
const modulos = await getCollection('modulos');
---
<section class="mapa contenedor" aria-labelledby="mapa-titulo">
  <Titulo id="mapa-titulo" class="mapa__titulo">{titulo}</Titulo>
  <p class="mapa__bajada">Cada pilar agrupa un mecanismo de comportamiento, no una industria.</p>

  <ul class="mapa__zonas">
    {pilares.map((p, i) => {
      const suyos = modulos.filter((m) => m.data.pilar.id === p.id);
      return (
        <li class={`zona zona--${i + 1}`} data-reveal>
          <a class="zona__enlace" href={`/pilares#${p.id}`} id={p.id}>
            <span class="zona__numero" aria-hidden="true">0{p.data.orden}</span>
            <Glifo pilar={p.id} />
            <Sub class="zona__nombre">{p.data.nombre}</Sub>
            <p class="zona__mecanismo">{p.data.mecanismo}</p>
            <p class="zona__teaser">{p.data.teaser}</p>
          </a>
          {suyos.length > 0 ? (
            <ul class="zona__modulos" aria-label={`Módulos de ${p.data.nombre}`}>
              {suyos.map((m) => (
                <li><a href={`/modulos/${m.id}`}>{m.data.titulo.replace(/\*/g, '')}</a>{m.data.ejemplo && <span class="etiqueta"> · ejemplo</span>}</li>
              ))}
            </ul>
          ) : (
            <p class="zona__vacio">Próximamente</p>
          )}
        </li>
      );
    })}
  </ul>
</section>

<style>
  .mapa { padding-block: var(--s-6); position: relative; z-index: 1; }
  .mapa__titulo { font-size: var(--t-card); }
  .mapa__bajada { color: var(--muted); max-width: 32rem; }

  .mapa__zonas {
    list-style: none; margin: var(--s-5) 0 0; padding: 0;
    display: grid; gap: var(--s-3); grid-template-columns: 1fr;
  }
  @media (min-width: 40rem) { .mapa__zonas { grid-template-columns: 1fr 1fr; } }
  /* Computador: mapa asimétrico, no una grilla de tarjetas iguales */
  @media (min-width: 52rem) {
    .mapa__zonas { grid-template-columns: repeat(6, 1fr); grid-auto-rows: minmax(11rem, auto); gap: var(--s-4); }
    .zona--1 { grid-column: 1 / span 3; grid-row: span 2; }
    .zona--2 { grid-column: 4 / span 3; }
    .zona--3 { grid-column: 4 / span 3; }
    .zona--4 { grid-column: 1 / span 2; }
    .zona--5 { grid-column: 3 / span 4; }
  }

  .zona {
    position: relative;
    background: var(--surface);
    border: 1.5px solid var(--outline);
    border-radius: var(--r-card);
    padding: var(--s-4);
    display: flex; flex-direction: column; gap: var(--s-2);
    transition: transform 400ms var(--ease), background 400ms var(--ease);
  }
  .zona:hover, .zona:focus-within { transform: translateY(-4px); background: var(--band); }

  .zona__enlace { text-decoration: none; display: flex; flex-direction: column; gap: var(--s-1); }
  .zona__enlace:focus-visible { outline-offset: 8px; }
  .zona__numero { font-size: var(--t-label); letter-spacing: 0.12em; color: var(--muted); }
  .zona__nombre { font-size: var(--t-card); margin: 0; }
  .zona__mecanismo { margin: 0; font-size: var(--t-body); }
  .zona__teaser { margin: 0; color: var(--muted); font-size: var(--t-small); }
  .zona__modulos { list-style: none; margin: auto 0 0; padding: var(--s-3) 0 0; border-top: 1.5px solid var(--outline); font-size: var(--t-small); }
  .zona__modulos a { display: inline-flex; min-height: 44px; align-items: center; }
  .zona__vacio { margin: auto 0 0; padding-top: var(--s-3); font-size: var(--t-small); color: var(--muted); }
</style>
