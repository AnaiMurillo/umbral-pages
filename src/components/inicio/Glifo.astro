---
// Miniatura de cada pilar: 2 o 3 formas planas, sin contorno (DESIGN §5).
interface Props { pilar: string }
const { pilar } = Astro.props;
---
<svg class={`glifo glifo--${pilar}`} viewBox="0 0 120 72" width="120" height="72" aria-hidden="true" focusable="false">
  {pilar === 'confianza' && (
    <g>
      <path class="glifo__a" d="M8 72 A44 44 0 0 1 96 72 Z" fill="var(--a1)" />
      <rect class="glifo__b" x="70" y="8" width="36" height="40" rx="12" fill="var(--a3)" />
      <circle cx="40" cy="52" r="4" fill="var(--tinta)" /><circle cx="60" cy="52" r="4" fill="var(--tinta)" />
    </g>
  )}
  {pilar === 'persuasion' && (
    <g>
      <circle class="glifo__a" cx="34" cy="38" r="30" fill="var(--a2)" />
      <rect class="glifo__b" x="58" y="30" width="56" height="16" rx="8" fill="var(--a1)" />
    </g>
  )}
  {pilar === 'comprension' && (
    <g>
      <rect x="6" y="10" width="100" height="16" rx="8" fill="var(--a4)" />
      <rect class="glifo__b" x="6" y="32" width="70" height="16" rx="8" fill="var(--a1)" />
      <rect class="glifo__a" x="6" y="54" width="36" height="16" rx="8" fill="var(--a3)" />
    </g>
  )}
  {pilar === 'atencion' && (
    <g>
      <circle cx="60" cy="36" r="34" fill="var(--a3)" />
      <circle class="glifo__a" cx="60" cy="36" r="16" fill="var(--a2)" />
      <circle cx="64" cy="32" r="5" fill="var(--tinta)" />
    </g>
  )}
  {pilar === 'identidad-digital' && (
    <g>
      <circle cx="40" cy="36" r="30" fill="var(--a1)" />
      <circle class="glifo__b" cx="76" cy="36" r="30" fill="var(--a2)" />
      <rect x="52" y="30" width="12" height="12" rx="4" fill="var(--tinta)" />
    </g>
  )}
</svg>

<style>
  .glifo { overflow: visible; margin-bottom: var(--s-2); }
  .glifo__a, .glifo__b { transition: transform 400ms var(--ease); transform-box: fill-box; transform-origin: center; }
  :global(.zona:hover) .glifo__a, :global(.zona:focus-within) .glifo__a { transform: translateY(-6px); }
  :global(.zona:hover) .glifo__b, :global(.zona:focus-within) .glifo__b { transform: translateX(6px) rotate(8deg); }
</style>
